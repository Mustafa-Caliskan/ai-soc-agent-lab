{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.64.0-beta-1791568591000"},"browser":{"name":"chromium","version":"155.0.8059.85"},"pages":[{"startedDateTime":"2026-10-22T07:46:40.448Z","id":"page@13749fc9bc1a0365d95d242ab2768263","title":"SkyPort Havayolları — Müşteri Asistanı","pageTimings":{"onContentLoad":221,"onLoad":223}}],"entries":[{"pageref":"page@13749fc9bc1a0365d95d242ab2768263","startedDateTime":"2026-10-22T07:46:40.467Z","time":133.56,"request":{"method":"GET","url":"http://127.0.0.1:8012/","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/jxl,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8012"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"none"},{"name":"Sec-Fetch-User","value":"?1"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/155.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Google Chrome\";v=\"155\", \"Chromium\";v=\"155\", \"Not(A:Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":701,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"accept-ranges","value":"bytes"},{"name":"content-length","value":"20052"},{"name":"content-type","value":"text/html; charset=utf-8"},{"name":"date","value":"Thu, 22 Oct 2026 07:46:40 GMT"},{"name":"etag","value":"\"957bd497fdc86265c10f0bf1d6232b72\""},{"name":"last-modified","value":"Wed, 21 Oct 2026 21:53:19 GMT"},{"name":"server","value":"uvicorn"}],"content":{"size":20052,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>SkyPort Havayolları — Müşteri Asistanı</title>\n  <style>\n    :root {\n      --navy: #071c33;\n      --navy-2: #0b2b4d;\n      --blue: #0b4f8a;\n      --teal: #0f9b8e;\n      --gold: #e3b04b;\n      --ink: #10243b;\n      --muted: #5c7189;\n      --line: #dbe5f0;\n      --bg: #f4f8fc;\n      --white: #ffffff;\n      --shadow: 0 18px 50px rgba(7, 28, 51, 0.16);\n    }\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      background: var(--bg);\n      color: var(--ink);\n      font-family: \"Segoe UI\", Arial, sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n    a { color: inherit; text-decoration: none; }\n    button, input, select, textarea { font: inherit; }\n    .container { width: min(1160px, calc(100% - 48px)); margin: 0 auto; }\n    header {\n      position: sticky;\n      top: 0;\n      z-index: 40;\n      background: rgba(255, 255, 255, 0.96);\n      background: var(--white);\n      border-bottom: 1px solid var(--line);\n    }\n    .nav {\n      height: 72px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n    .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; letter-spacing: 0.08em; }\n    .brand-mark {\n      width: 38px;\n      height: 38px;\n      border-radius: 11px;\n      background: linear-gradient(135deg, var(--blue), var(--teal));\n      display: grid;\n      place-items: center;\n      color: #fff;\n    }\n    .brand-mark svg { width: 21px; height: 21px; fill: currentColor; }\n    .brand-text { display: flex; flex-direction: column; line-height: 1.05; }\n    .brand-text strong { font-size: 17px; letter-spacing: 0.12em; color: var(--navy); }\n    .brand-text span { font-size: 10px; letter-spacing: 0.22em; color: var(--muted); font-weight: 600; }\n    .nav-links { display: flex; gap: 26px; align-items: center; font-size: 14px; font-weight: 600; color: #334a63; }\n    .nav-links a:hover { color: var(--blue); }\n    .nav-actions { display: flex; align-items: center; gap: 10px; }\n    .btn {\n      border: 0;\n      border-radius: 10px;\n      padding: 10px 16px;\n      font-weight: 700;\n      cursor: pointer;\n    }\n    .btn-primary { background: var(--blue); color: #fff; }\n    .btn-primary:hover { background: #093f6f; }\n    .btn-ghost { background: #edf4fb; color: var(--blue); }\n    .hero {\n      background:\n        radial-gradient(circle at 78% 18%, rgba(15, 155, 142, 0.34), transparent 34%),\n        radial-gradient(circle at 15% 80%, rgba(227, 176, 75, 0.18), transparent 30%),\n        linear-gradient(120deg, var(--navy), var(--navy-2) 55%, #0a3e66);\n      color: #fff;\n      padding: 72px 0 86px;\n    }\n    .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; }\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 12px;\n      border: 1px solid rgba(255,255,255,0.22);\n      border-radius: 999px;\n      font-size: 11px;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      color: #cfe7ff;\n      background: rgba(255,255,255,0.06);\n    }\n    .hero h1 { font-size: clamp(34px, 4.3vw, 56px); line-height: 1.05; margin: 18px 0 16px; letter-spacing: -1.2px; }\n    .hero p { max-width: 560px; color: #c6d8ea; font-size: 16px; line-height: 1.7; margin: 0 0 26px; }\n    .hero-badges { display: flex; gap: 18px; flex-wrap: wrap; color: #d9e9f7; font-size: 13px; }\n    .hero-badges span { display: flex; align-items: center; gap: 8px; }\n    .hero-badges i { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); display: inline-block; }\n    .search-card {\n      background: #fff;\n      color: var(--ink);\n      border-radius: 18px;\n      padding: 22px;\n      box-shadow: var(--shadow);\n    }\n    .search-card h2 { margin: 0 0 16px; font-size: 19px; }\n    .radio-row { display: flex; gap: 18px; margin-bottom: 14px; font-size: 13px; color: var(--muted); }\n    .radio-row label { display: flex; align-items: center; gap: 6px; }\n    .search-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n    .field { display: flex; flex-direction: column; gap: 6px; }\n    .field.wide { grid-column: span 2; }\n    .field label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }\n    .field input, .field select {\n      border: 1px solid var(--line);\n      border-radius: 9px;\n      padding: 11px 12px;\n      color: var(--ink);\n      background: #fbfdff;\n      outline: none;\n    }\n    .field input:focus, .field select:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(15,155,142,0.12); }\n    .search-card .btn { width: 100%; margin-top: 14px; padding: 12px 16px; background: var(--teal); }\n    .search-card .btn:hover { background: #0c847a; }\n    .feature-strip { padding: 0 0 64px; margin-top: -34px; position: relative; z-index: 2; }\n    .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }\n    .feature-card {\n      background: #fff;\n      border: 1px solid var(--line);\n      border-radius: 14px;\n      padding: 22px;\n      box-shadow: 0 8px 26px rgba(7,28,51,0.06);\n    }\n    .feature-icon {\n      width: 42px; height: 42px; border-radius: 10px;\n      display: grid; place-items: center; margin-bottom: 14px;\n      background: #eaf6f5; color: var(--teal);\n    }\n    .feature-card h3 { margin: 0 0 8px; font-size: 16px; }\n    .feature-card p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }\n    .info { padding: 26px 0 70px; }\n    .info-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 26px; align-items: center; }\n    .info h2 { margin: 0 0 12px; font-size: 28px; letter-spacing: -0.5px; }\n    .info p { color: var(--muted); line-height: 1.7; font-size: 14px; }\n    .info-panel {\n      background: linear-gradient(140deg, #0d3c63, #0a2340);\n      color: #fff;\n      border-radius: 16px;\n      padding: 24px;\n    }\n    .info-panel strong { display: block; font-size: 30px; margin-bottom: 6px; }\n    .info-panel span { color: #bcd4e8; font-size: 13px; line-height: 1.6; }\n    footer { background: #06172a; color: #a9c0d5; padding: 30px 0; font-size: 12px; }\n    .footer-row { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }\n    .chat-launcher {\n      position: fixed;\n      right: 24px;\n      bottom: 24px;\n      z-index: 60;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      border: 0;\n      border-radius: 999px;\n      padding: 13px 18px 13px 14px;\n      background: linear-gradient(135deg, var(--blue), var(--teal));\n      color: #fff;\n      font-weight: 800;\n      box-shadow: 0 16px 34px rgba(7,28,51,0.28);\n      cursor: pointer;\n    }\n    .chat-launcher svg { width: 20px; height: 20px; fill: currentColor; }\n    .chat-panel {\n      position: fixed;\n      right: 24px;\n      bottom: 24px;\n      z-index: 70;\n      width: 390px;\n      height: 570px;\n      max-height: calc(100vh - 48px);\n      background: #fff;\n      border: 1px solid var(--line);\n      border-radius: 18px;\n      box-shadow: 0 28px 70px rgba(7,28,51,0.28);\n      display: none;\n      flex-direction: column;\n      overflow: hidden;\n    }\n    .chat-panel.open { display: flex; }\n    .chat-head {\n      background: linear-gradient(135deg, var(--navy), var(--blue));\n      color: #fff;\n      padding: 15px 16px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    .agent-avatar {\n      width: 38px; height: 38px; border-radius: 50%;\n      background: rgba(255,255,255,0.14);\n      display: grid; place-items: center;\n      font-weight: 800; font-size: 13px;\n    }\n    .chat-head-info { flex: 1; line-height: 1.25; }\n    .chat-head-info strong { display: block; font-size: 14px; }\n    .chat-head-info span { font-size: 11px; color: #b9e7df; }\n    .chat-close {\n      border: 0; background: transparent; color: #dceeff;\n      font-size: 22px; cursor: pointer; line-height: 1;\n    }\n    .chat-messages {\n      flex: 1;\n      overflow-y: auto;\n      padding: 16px;\n      background: #f7fafd;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .bubble {\n      max-width: 86%;\n      padding: 10px 13px;\n      border-radius: 13px;\n      font-size: 13px;\n      line-height: 1.5;\n      white-space: pre-wrap;\n      word-break: break-word;\n    }\n    .bubble.assistant { align-self: flex-start; background: #fff; border: 1px solid var(--line); color: #24384e; border-bottom-left-radius: 4px; }\n    .bubble.user { align-self: flex-end; background: var(--blue); color: #fff; border-bottom-right-radius: 4px; }\n    .quick-row { display: flex; flex-wrap: wrap; gap: 7px; padding: 0 16px 12px; background: #f7fafd; }\n    .quick {\n      border: 1px solid #cfe2f2;\n      background: #fff;\n      color: var(--blue);\n      border-radius: 999px;\n      padding: 6px 10px;\n      font-size: 11px;\n      font-weight: 700;\n      cursor: pointer;\n    }\n    .quick:hover { background: #eef7ff; }\n    .chat-input-row {\n      display: flex;\n      gap: 8px;\n      padding: 12px;\n      border-top: 1px solid var(--line);\n      background: #fff;\n    }\n    #chatInput {\n      flex: 1;\n      min-height: 42px;\n      max-height: 100px;\n      resize: vertical;\n      border: 1px solid var(--line);\n      border-radius: 11px;\n      padding: 10px 11px;\n      font-size: 13px;\n      outline: none;\n    }\n    #chatInput:focus { border-color: var(--teal); }\n    #chatSend {\n      border: 0;\n      border-radius: 11px;\n      padding: 0 15px;\n      background: var(--teal);\n      color: #fff;\n      font-weight: 800;\n      cursor: pointer;\n    }\n    #chatSend:disabled { opacity: 0.55; cursor: not-allowed; }\n    @media (max-width: 960px) {\n      .hero-grid, .info-grid { grid-template-columns: 1fr; }\n      .feature-grid { grid-template-columns: 1fr; }\n      .nav-links { display: none; }\n      .hero { padding-top: 48px; }\n      .chat-panel { right: 12px; bottom: 12px; width: calc(100% - 24px); height: 78vh; }\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <div class=\"container nav\">\n      <a class=\"brand\" href=\"/\">\n        <span class=\"brand-mark\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2.2 21.3 22.8 12 2.2 2.7l.1 7.2L17 12 2.3 14.1z\"/></svg>\n        </span>\n        <span class=\"brand-text\"><strong>SKYPORT</strong><span>HAVAYOLLARI</span></span>\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Ana menü\">\n        <a href=\"#ucus\">Uçuşlar</a>\n        <a href=\"#checkin\">Check-in</a>\n        <a href=\"#bagaj\">Bagaj</a>\n        <a href=\"#destek\">Destek</a>\n      </nav>\n      <div class=\"nav-actions\">\n        <button class=\"btn btn-ghost\" type=\"button\" onclick=\"openChat()\">Müşteri Asistanı</button>\n        <button class=\"btn btn-primary\" type=\"button\" onclick=\"alert('Bu bir demo sitesidir.')\">Bilet Al</button>\n      </div>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div>\n          <span class=\"eyebrow\">Yeni nesil yolculuk deneyimi</span>\n          <h1>Gökyüzüne açılan kapınız.</h1>\n          <p>Uçuşunuzu planlayın, check-in yapın ve yolculuğunuz boyunca ihtiyacınız olan her şeyi tek yerden yönetin.</p>\n          <div class=\"hero-badges\">\n            <span><i></i> 120+ destinasyon</span>\n            <span><i></i> 7/24 müşteri desteği</span>\n            <span><i></i> Güvenli ödeme</span>\n          </div>\n        </div>\n        <div class=\"search-card\" id=\"ucus\">\n          <h2>Uçuşunuzu bulun</h2>\n          <div class=\"radio-row\">\n            <label><input type=\"radio\" name=\"trip\" checked /> Gidiş-dönüş</label>\n            <label><input type=\"radio\" name=\"trip\" /> Tek yön</label>\n          </div>\n          <form class=\"search-grid\" onsubmit=\"event.preventDefault(); alert('Bu bir demo sitesidir.');\">\n            <div class=\"field\">\n              <label for=\"from\">Nereden</label>\n              <input id=\"from\" value=\"İstanbul (IST)\" />\n            </div>\n            <div class=\"field\">\n              <label for=\"to\">Nereye</label>\n              <input id=\"to\" value=\"Ankara (ESB)\" />\n            </div>\n            <div class=\"field\">\n              <label for=\"date\">Gidiş tarihi</label>\n              <input id=\"date\" type=\"date\" value=\"2026-11-12\" />\n            </div>\n            <div class=\"field\">\n              <label for=\"passengers\">Yolcu</label>\n              <select id=\"passengers\"><option>1 yetişkin</option><option>2 yetişkin</option><option>1 yetişkin + 1 çocuk</option></select>\n            </div>\n            <div class=\"field wide\">\n              <button class=\"btn\" type=\"submit\">Uçuş Ara</button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"feature-strip\">\n      <div class=\"container feature-grid\">\n        <article class=\"feature-card\">\n          <div class=\"feature-icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M22 16.5v-2l-8.5-5V3.8a1.5 1.5 0 0 0-3 0v5.7L2 14.5v2l8.5-2.5v5.2L8 21v1.5l4-1 4 1V21l-2.5-1.8V14z\"/></svg>\n          </div>\n          <h3>Uçuş Durumu</h3>\n          <p>Kalkış ve varış bilgilerini anlık olarak takip edin, gecikmelerden haberdar olun.</p>\n        </article>\n        <article class=\"feature-card\" id=\"checkin\">\n          <div class=\"feature-icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z\"/></svg>\n          </div>\n          <h3>Online Check-in</h3>\n          <p>Uçuşunuzdan 24 saat önce check-in yapın, zamanınızı havalimanında rahat geçirin.</p>\n        </article>\n        <article class=\"feature-card\" id=\"bagaj\">\n          <div class=\"feature-icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M9 4h6v2h3a3 3 0 0 1 3 3v10h-2v-2H5v2H3V9a3 3 0 0 1 3-3h3V4zm2 2h2V4h-2v2zM7 9v8h10V9H7z\"/></svg>\n          </div>\n          <h3>Bagaj Bilgisi</h3>\n          <p>Bagaj hakkınızı görüntüleyin, ek bagaj alın ve kayıp bagaj süreçlerini yönetin.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"info\" id=\"destek\">\n      <div class=\"container info-grid\">\n        <div>\n          <h2>Yolculuğunuzda yanınızdayız.</h2>\n          <p>SkyPort Müşteri Asistanı; uçuş, bagaj ve check-in sorularınızı yanıtlamak için 7/24 hizmetinizde. Sorunuzu yazın, size en kısa sürede yardımcı olalım.</p>\n        </div>\n        <div class=\"info-panel\">\n          <strong>7/24</strong>\n          <span>Müşteri desteği<br />Ortalama yanıt süresi: 2 saniye</span>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"container footer-row\">\n      <span>© 2026 SkyPort Havayolları. Tüm hakları saklıdır.</span>\n      <span>Uçuşlar · Check-in · Bagaj · Destek</span>\n    </div>\n  </footer>\n\n  <button class=\"chat-launcher\" id=\"chatLauncher\" type=\"button\" onclick=\"openChat()\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 3h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2zm3 6h10V7H7v2zm0 4h7v-2H7v2z\"/></svg>\n    Müşteri Asistanı\n  </button>\n\n  <section class=\"chat-panel\" id=\"chatPanel\" aria-label=\"Müşteri asistanı sohbeti\">\n    <div class=\"chat-head\">\n      <div class=\"agent-avatar\">SA</div>\n      <div class=\"chat-head-info\">\n        <strong>SkyPort Müşteri Asistanı</strong>\n        <span id=\"chatStatus\">Çevrimiçi</span>\n      </div>\n      <button class=\"chat-close\" type=\"button\" aria-label=\"Kapat\" onclick=\"closeChat()\">×</button>\n    </div>\n    <div class=\"chat-messages\" id=\"chatMessages\">\n      <div class=\"bubble assistant\">Merhaba! SkyPort Müşteri Asistanı'na hoş geldiniz. Uçuş, bagaj veya check-in konusunda nasıl yardımcı olabilirim?</div>\n    </div>\n    <div class=\"quick-row\">\n      <button class=\"quick\" type=\"button\" onclick=\"askQuick('Uçuş durumu')\">Uçuş durumu</button>\n      <button class=\"quick\" type=\"button\" onclick=\"askQuick('Bagaj hakkım nedir?')\">Bagaj hakkı</button>\n      <button class=\"quick\" type=\"button\" onclick=\"askQuick('Check-in nasıl yapılır?')\">Check-in</button>\n    </div>\n    <div class=\"chat-input-row\">\n      <textarea id=\"chatInput\" rows=\"1\" placeholder=\"Mesajınızı yazın...\" aria-label=\"Mesaj\"></textarea>\n      <button id=\"chatSend\" type=\"button\">Gönder</button>\n    </div>\n  </section>\n\n  <script>\n    const chatPanel = document.getElementById('chatPanel');\n    const chatLauncher = document.getElementById('chatLauncher');\n    const chatMessages = document.getElementById('chatMessages');\n    const chatInput = document.getElementById('chatInput');\n    const chatSend = document.getElementById('chatSend');\n    const chatStatus = document.getElementById('chatStatus');\n    let busy = false;\n\n    function openChat() {\n      chatPanel.classList.add('open');\n      chatLauncher.style.display = 'none';\n      chatInput.focus();\n    }\n\n    function closeChat() {\n      chatPanel.classList.remove('open');\n      chatLauncher.style.display = 'flex';\n    }\n\n    function addBubble(role, text) {\n      const bubble = document.createElement('div');\n      bubble.className = 'bubble ' + role;\n      bubble.textContent = text;\n      chatMessages.appendChild(bubble);\n      chatMessages.scrollTop = chatMessages.scrollHeight;\n      return bubble;\n    }\n\n    function askQuick(text) {\n      chatInput.value = text;\n      sendMessage();\n    }\n\n    async function sendMessage() {\n      const text = chatInput.value.trim();\n      if (!text || busy) return;\n      busy = true;\n      chatSend.disabled = true;\n      chatStatus.textContent = 'Yazıyor...';\n      chatInput.value = '';\n      addBubble('user', text);\n      const reply = addBubble('assistant', '');\n\n      try {\n        const response = await fetch('/api/customer/chat/stream', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ message: text, model: 'gemma-4-31b' })\n        });\n        if (!response.ok) {\n          throw new Error('İstek başarısız: ' + response.status);\n        }\n        const reader = response.body.getReader();\n        const decoder = new TextDecoder();\n        let buffer = '';\n        while (true) {\n          const { value, done } = await reader.read();\n          if (done) break;\n          buffer += decoder.decode(value, { stream: true });\n          let boundary = buffer.indexOf('\\n\\n');\n          while (boundary !== -1) {\n            const block = buffer.slice(0, boundary);\n            buffer = buffer.slice(boundary + 2);\n            for (const line of block.split('\\n')) {\n              if (!line.startsWith('data:')) continue;\n              const payload = line.slice(5).trim();\n              if (!payload) continue;\n              let event;\n              try { event = JSON.parse(payload); } catch { continue; }\n              if (event.type === 'content') {\n                reply.textContent += event.delta || '';\n                chatMessages.scrollTop = chatMessages.scrollHeight;\n              } else if (event.type === 'error') {\n                reply.textContent += '\\n[Hata] ' + (event.message || 'Bilinmeyen hata');\n              }\n            }\n            boundary = buffer.indexOf('\\n\\n');\n          }\n        }\n      } catch (error) {\n        reply.textContent += '\\n[Hata] ' + error.message;\n      } finally {\n        busy = false;\n        chatSend.disabled = false;\n        chatStatus.textContent = 'Çevrimiçi';\n        chatInput.focus();\n      }\n    }\n\n    chatSend.addEventListener('click', sendMessage);\n    chatInput.addEventListener('keydown', (event) => {\n      if (event.key === 'Enter' && !event.shiftKey) {\n        event.preventDefault();\n        sendMessage();\n      }\n    });\n\n    if (window.innerWidth > 960) {\n      openChat();\n    }\n  </script>\n</body>\n</html>\n"},"headersSize":246,"bodySize":20052,"redirectURL":"","_transferSize":20298},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":93.865,"receive":39.695},"_frameref":"frame@52ce70f76c6f58189cf32c95d2317a62","_monotonicTime":2065.988,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":8012,"_securityDetails":{}},{"pageref":"page@13749fc9bc1a0365d95d242ab2768263","startedDateTime":"2026-10-22T07:46:41.281Z","time":3572.0389999999998,"request":{"method":"POST","url":"http://127.0.0.1:8012/api/customer/chat/stream","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"149"},{"name":"Content-Type","value":"application/json"},{"name":"Host","value":"127.0.0.1:8012"},{"name":"Origin","value":"http://127.0.0.1:8012"},{"name":"Referer","value":"http://127.0.0.1:8012/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"}